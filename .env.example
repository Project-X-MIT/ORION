APP_ENV=development
API_BIND_ADDRESS=127.0.0.1:3000
DATABASE_URL=postgres://orion:orion@localhost:5432/orion
DATABASE_MAX_CONNECTIONS=10
REDIS_URL=redis://127.0.0.1:6379
SESSION_TTL_SECONDS=86400
SESSION_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173
REQUEST_TIMEOUT_SECONDS=30
SHUTDOWN_TIMEOUT_SECONDS=15
RUST_LOG=orion_api=info,tower_http=info
LOG_FORMAT=json

# Production image promotion and TLS (never put secret values in this file).
ORION_API_IMAGE=ghcr.io/project-x-mit/orion-api@sha256:DIGEST
ORION_WORKER_IMAGE=ghcr.io/project-x-mit/orion-worker@sha256:DIGEST
ORION_FRONTEND_IMAGE=ghcr.io/project-x-mit/orion-frontend@sha256:DIGEST
ORION_DOMAIN=orion.example.com
