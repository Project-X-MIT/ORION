FROM node:22.14.0-bookworm-slim AS builder

WORKDIR /app
COPY package.json package-lock.json ./
COPY frontend/package.json frontend/package-lock.json ./frontend/
RUN npm ci --ignore-scripts
RUN npm install --no-save --package-lock=false --ignore-scripts @rollup/rollup-linux-x64-gnu@4.62.4
COPY frontend ./frontend
RUN npm run build --workspace frontend

FROM caddy:2.10.0-alpine

COPY --from=builder /app/frontend/dist /srv
COPY infra/caddy/Caddyfile /etc/caddy/Caddyfile
RUN addgroup -S caddy \
    && adduser -S -G caddy caddy \
    && mkdir -p /data /config \
    && chown -R caddy:caddy /srv /etc/caddy /data /config
USER caddy
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 \
    CMD wget --quiet --output-document=- http://127.0.0.1:8080/health/live >/dev/null || exit 1
ENTRYPOINT ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
